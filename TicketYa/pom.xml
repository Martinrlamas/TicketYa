<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- POM raíz: versiones y dependencias comunes. Cada módulo solo declara lo que le es propio. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/>
    </parent>

    <groupId>com.ticketya</groupId>
    <artifactId>ticketya-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>ticketya-parent</name>

    <modules>
        <module>platform/ticketya-platform-starter</module>
        <module>services/ms-catalog-service</module>
        <module>services/ms-inventory-service</module>
        <module>services/ms-order-service</module>
        <module>services/ms-payment-service</module>
        <module>services/ms-ticket-service</module>
        <module>services/ms-api-gateway</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>2.8.9</springdoc.version>
        <archunit.version>1.3.0</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.ticketya</groupId>
                <artifactId>ticketya-platform-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
