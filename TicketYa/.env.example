# Opcional: docker compose ya trae estos valores por defecto. Copiar a .env solo para cambiarlos.
# Valores SOLO para desarrollo.

# Secreto compartido para /internal/** (header X-Internal-Token). Igual en todos los servicios.
INTERNAL_TOKEN=dev-internal-token

# Superusuario de PostgreSQL (lo usa solo el contenedor). Las bases y usuarios de cada servicio
# se crean en infra/postgres/init-databases.sql.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
